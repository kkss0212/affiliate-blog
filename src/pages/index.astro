---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const allPrefectures = await getCollection("prefectures", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const prefectures = allPrefectures.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title="Japan Unpacked — Japan's prefectures, music, and manga, unpacked"
  description="History- and data-driven guides to Japan's prefectures, plus guides to Japanese music and manga."
>
  <h1 class="text-2xl font-semibold">Japan Unpacked</h1>
  <p class="mt-2 text-slate-600">
    Japan's prefectures, music, and manga — unpacked with history and data,
    written for people planning a visit or just exploring from afar.
  </p>

  <h2 class="mt-8 text-lg font-semibold">Prefectures</h2>
  <ul class="mt-3 space-y-3">
    {
      prefectures.map((prefecture) => (
        <li>
          <a
            href={`${import.meta.env.BASE_URL}prefectures/${prefecture.id}/`}
            class="block rounded-lg border border-slate-200 p-4 hover:border-slate-400"
          >
            <span class="font-medium">{prefecture.data.name}</span>
            <span class="ml-2 text-sm text-slate-500">{prefecture.data.region}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
