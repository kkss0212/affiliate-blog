---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { groupByPrimaryGenre } from "../../lib/genreGroups";

const allEntries = await getCollection("manga", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const entries = allEntries.sort((a, b) => a.data.title.localeCompare(b.data.title));
const groups = groupByPrimaryGenre(entries);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Manga Guides | Japan Unpacked"
  description="Guides to manga series that have found an audience beyond Japan, with ways to read."
>
  <p class="text-sm font-medium uppercase tracking-[0.15em] text-accent">Japan Unpacked</p>
  <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight">Manga</h1>
  <p class="mt-4 max-w-xl text-ink-soft">
    Manga series that have built a real following outside Japan — where the
    creator is from, what makes the series distinctive, and where to start
    reading.
  </p>

  {
    groups.length > 1 && (
      <nav class="mt-6 flex flex-wrap gap-2 text-sm">
        {groups.map((group) => (
          <a
            href={`#${group.slug}`}
            class="rounded-full border border-line bg-white px-3 py-1 text-ink-soft transition hover:border-accent hover:text-accent"
          >
            {group.genre}
          </a>
        ))}
      </nav>
    )
  }

  {
    groups.map((group) => (
      <section id={group.slug} class="mt-10 scroll-mt-20">
        <h2 class="font-display text-lg font-semibold">{group.genre}</h2>
        <ul class="mt-3 grid gap-3 sm:grid-cols-2">
          {group.entries.map((entry) => (
            <li>
              <a
                href={`${base}manga/${entry.id}/`}
                class="block rounded-xl border border-line bg-white p-4 transition hover:-translate-y-0.5 hover:shadow-md"
              >
                <span class="font-medium">{entry.data.title}</span>
                {entry.data.nameJa && <span class="ml-2 text-xs text-ink-faint">{entry.data.nameJa}</span>}
                {entry.data.tagline && <p class="mt-1 text-sm text-ink-soft">{entry.data.tagline}</p>}
                {entry.data.genres.length > 0 && (
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {entry.data.genres.map((genre) => (
                      <span class="rounded-full bg-accent-soft/60 px-2 py-0.5 text-[11px] font-medium text-accent">
                        {genre}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  {entries.length === 0 && <p class="mt-4 text-sm text-ink-faint">More guides are on the way.</p>}
</BaseLayout>
