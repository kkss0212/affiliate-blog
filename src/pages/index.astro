---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const allPrefectures = await getCollection("prefectures", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const prefectures = allPrefectures.sort((a, b) => a.data.name.localeCompare(b.data.name));

const sections = [
  { href: base, label: "Prefectures", desc: "History & data, down to individual cities" },
  { href: `${base}music/`, label: "Music", desc: "Artists and genres worth hearing" },
  { href: `${base}manga/`, label: "Manga", desc: "Series worth starting" },
];
---

<BaseLayout
  title="Japan Unpacked — Japan's prefectures, municipalities, music, and manga, unpacked"
  description="History- and data-driven guides to Japan's prefectures, municipalities, music, and manga — for anyone learning about Japan, dreaming of a future trip, or planning one now."
>
  <p class="font-display text-sm uppercase tracking-[0.2em] text-accent">Japan Unpacked</p>
  <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
    Japan, told through history and data
  </h1>
  <p class="mt-4 max-w-xl text-ink-soft">
    Guides to Japan's prefectures, cities, music, and manga — for anyone
    learning about Japan, dreaming of a trip they can't take yet, or
    planning one right now.
  </p>

  <div class="mt-8 grid gap-3 sm:grid-cols-3">
    {
      sections.map((section) => (
        <a
          href={section.href}
          class="block rounded-xl border border-line bg-white p-4 transition hover:-translate-y-0.5 hover:shadow-md"
        >
          <p class="font-display font-semibold">{section.label}</p>
          <p class="mt-1 text-sm text-ink-soft">{section.desc}</p>
        </a>
      ))
    }
  </div>

  <div class="mt-14 flex items-baseline justify-between">
    <h2 class="font-display text-xl font-semibold">Prefectures</h2>
    <a href={`${base}municipalities/`} class="text-sm text-ink-soft hover:text-accent">
      Browse all municipalities →
    </a>
  </div>
  <p class="mt-1 text-sm text-ink-faint">
    Each prefecture's page links to its cities, wards, towns, and villages.
  </p>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {
      prefectures.map((prefecture) => (
        <li>
          <a
            href={`${base}prefectures/${prefecture.id}/`}
            class="flex items-center justify-between rounded-xl border border-line bg-white p-4 transition hover:-translate-y-0.5 hover:shadow-md"
          >
            <span class="font-medium">{prefecture.data.name}</span>
            <span class="rounded-full bg-accent-soft px-2 py-0.5 text-xs text-accent">
              {prefecture.data.region}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  {
    prefectures.length === 0 && (
      <p class="mt-4 text-sm text-ink-faint">More guides are on the way.</p>
    )
  }
</BaseLayout>
