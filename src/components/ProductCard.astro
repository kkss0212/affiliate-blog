---
interface Props {
  name: string;
  description: string;
  url: string;
  retailer: "amazon" | "japan-trend-shop";
}

const { name, description, url, retailer } = Astro.props;

const retailerLabel: Record<Props["retailer"], string> = {
  amazon: "View on Amazon",
  "japan-trend-shop": "View on Japan Trend Shop",
};
---

<a
  href={url}
  rel="sponsored noopener"
  target="_blank"
  class="block rounded-xl border border-line bg-white p-4 transition hover:-translate-y-0.5 hover:shadow-md"
>
  <p class="font-medium">{name}</p>
  <p class="mt-1 text-sm text-ink-soft">{description}</p>
  <p class="mt-2 text-sm font-medium text-accent">{retailerLabel[retailer]} →</p>
</a>
