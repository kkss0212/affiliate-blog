---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getRankingEntries, RANKING_METRICS } from "../lib/rankings";
import { getRecentEntries, RECENT_KIND_LABEL } from "../lib/recent";

const base = import.meta.env.BASE_URL;

const sections = [
  { href: `${base}prefectures/`, label: "Prefectures", desc: "History & data, down to individual cities" },
  { href: `${base}music/`, label: "Music", desc: "Artists and genres worth hearing" },
  { href: `${base}manga/`, label: "Manga", desc: "Series worth starting" },
];

const allEntries = await getRankingEntries(base);
const recentEntries = await getRecentEntries(base, 5);

const dateFormatter = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<BaseLayout
  title="Japan Unpacked — Japan's prefectures, municipalities, music, and manga, unpacked"
  description="History- and data-driven guides to Japan's prefectures, municipalities, music, and manga — for anyone learning about Japan, dreaming of a future trip, or planning one now."
>
  <p class="font-display text-sm uppercase tracking-[0.2em] text-accent">Japan Unpacked</p>
  <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
    Japan, told through history and data
  </h1>
  <p class="mt-4 max-w-xl text-ink-soft">
    Guides to Japan's prefectures, cities, music, and manga — for anyone
    learning about Japan, dreaming of a trip they can't take yet, or
    planning one right now.
  </p>

  <div class="mt-8 grid gap-3 sm:grid-cols-3">
    {
      sections.map((section) => (
        <a
          href={section.href}
          class="block rounded-xl border border-line bg-white p-4 transition hover:-translate-y-0.5 hover:shadow-md"
        >
          <p class="font-display font-semibold">{section.label}</p>
          <p class="mt-1 text-sm text-ink-soft">{section.desc}</p>
        </a>
      ))
    }
  </div>

  <section class="mt-10 rounded-xl border border-line bg-accent-soft p-4 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="font-display text-lg font-semibold">Rankings</h2>
      <a href={`${base}rankings/`} class="text-sm text-ink-soft hover:text-accent">
        Full rankings →
      </a>
    </div>

    <select
      id="home-rankings-metric"
      class="mt-4 rounded-lg border border-line bg-white px-3 py-2 text-sm"
    >
      {RANKING_METRICS.map((metric) => (
        <option value={metric.key}>{metric.label}</option>
      ))}
    </select>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div>
        <h3 class="text-sm font-medium text-ink-soft">Prefectures</h3>
        <ol id="home-rankings-prefecture" class="mt-2 space-y-2"></ol>
        <p id="home-rankings-prefecture-empty" class="mt-2 hidden text-sm text-ink-faint">
          No entries have this metric yet.
        </p>
      </div>
      <div>
        <h3 class="text-sm font-medium text-ink-soft">Municipalities</h3>
        <ol id="home-rankings-municipality" class="mt-2 space-y-2"></ol>
        <p id="home-rankings-municipality-empty" class="mt-2 hidden text-sm text-ink-faint">
          No entries have this metric yet.
        </p>
      </div>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-lg font-semibold">Latest Updates</h2>
    <ul class="mt-3 divide-y divide-line rounded-xl border border-line bg-white">
      {
        recentEntries.map((entry) => (
          <li>
            <a
              href={entry.url}
              class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 transition hover:bg-paper"
            >
              <span class="flex items-center gap-3">
                <span class="rounded-full bg-accent-soft px-2 py-0.5 text-xs text-accent">
                  {RECENT_KIND_LABEL[entry.kind]}
                </span>
                <span class="font-medium">{entry.title}</span>
              </span>
              <span class="text-sm text-ink-faint">{dateFormatter.format(entry.updatedDate)}</span>
            </a>
          </li>
        ))
      }
    </ul>
    {
      recentEntries.length === 0 && (
        <p class="mt-3 text-sm text-ink-faint">No updates yet.</p>
      )
    }
  </section>

  <script
    type="application/json"
    id="home-rankings-data"
    set:html={JSON.stringify({ entries: allEntries, metrics: RANKING_METRICS })}
  />
  <script>
    const payload = JSON.parse(document.getElementById("home-rankings-data")!.textContent!);
    const { entries, metrics } = payload as {
      entries: {
        name: string;
        url: string;
        scope: "prefecture" | "municipality";
        parentName: string | null;
        metrics: Record<string, number | null>;
      }[];
      metrics: { key: string; label: string; unit: string }[];
    };

    const metricSelect = document.getElementById("home-rankings-metric") as HTMLSelectElement;

    function formatValue(value: number, unit: string) {
      const formatted = Number.isInteger(value)
        ? value.toLocaleString("en-US")
        : value.toLocaleString("en-US", { maximumFractionDigits: 1 });
      return unit ? `${formatted} ${unit}` : formatted;
    }

    function renderColumn(scope: "prefecture" | "municipality") {
      const list = document.getElementById(`home-rankings-${scope}`)!;
      const emptyNote = document.getElementById(`home-rankings-${scope}-empty`)!;
      const metricKey = metricSelect.value;
      const metric = metrics.find((m) => m.key === metricKey)!;

      const ranked = entries
        .filter((entry) => entry.scope === scope)
        .filter((entry) => entry.metrics[metricKey] !== null && entry.metrics[metricKey] !== undefined)
        .sort((a, b) => (b.metrics[metricKey] as number) - (a.metrics[metricKey] as number))
        .slice(0, 10);

      list.innerHTML = "";
      emptyNote.classList.toggle("hidden", ranked.length > 0);

      ranked.forEach((entry, index) => {
        const li = document.createElement("li");
        li.className =
          "flex items-center justify-between rounded-lg border border-line bg-white p-3 transition hover:-translate-y-0.5 hover:shadow-md";
        li.innerHTML = `
          <a href="${entry.url}" class="flex items-center gap-2">
            <span class="font-display w-5 text-ink-faint">${index + 1}</span>
            <span>
              <span class="font-medium">${entry.name}</span>
              ${entry.parentName ? `<span class="ml-1 text-xs text-ink-faint">(${entry.parentName})</span>` : ""}
            </span>
          </a>
          <span class="text-sm font-medium text-accent">${formatValue(entry.metrics[metricKey] as number, metric.unit)}</span>
        `;
        list.appendChild(li);
      });
    }

    function render() {
      renderColumn("prefecture");
      renderColumn("municipality");
    }

    metricSelect.addEventListener("change", render);
    render();
  </script>
</BaseLayout>
