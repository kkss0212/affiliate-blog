---
// "Share of Japan" comparison bar — e.g. this prefecture's population as
// a percentage of Japan's total. The number is the real share; the bar
// gets a small minimum width purely so it stays visible/legible on-screen
// for small shares, never used to visually inflate the reported percent.
interface Props {
  label: string;
  value: number;
  nationalTotal: number;
}

const { label, value, nationalTotal } = Astro.props;
const pct = (value / nationalTotal) * 100;
const pctFormatted = pct.toLocaleString("en-US", {
  maximumFractionDigits: pct < 1 ? 2 : 1,
});
const barPct = Math.max(3, Math.min(100, pct));
---

<div>
  <div class="flex items-baseline justify-between text-sm">
    <span class="text-ink-soft">{label}</span>
    <span class="font-medium text-ink">{pctFormatted}% of Japan</span>
  </div>
  <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-line">
    <div class="h-full rounded-full bg-accent/70" style={`width: ${barPct}%`} />
  </div>
</div>
