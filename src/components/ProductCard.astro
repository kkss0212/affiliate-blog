---
import { ShoppingBag, Gift } from "@lucide/astro";

interface Props {
  name: string;
  description: string;
  url: string;
  retailer: "amazon" | "japan-trend-shop";
}

const { name, description, url, retailer } = Astro.props;

const retailerLabel: Record<Props["retailer"], string> = {
  amazon: "View on Amazon",
  "japan-trend-shop": "View on Japan Trend Shop",
};
const RetailerIcon = retailer === "amazon" ? ShoppingBag : Gift;
---

<a
  href={url}
  rel="sponsored noopener"
  target="_blank"
  data-affiliate-kind="product"
  data-affiliate-channel={retailer}
  data-affiliate-name={name}
  class="flex gap-3 rounded-xl border border-line bg-white p-4 transition hover:-translate-y-0.5 hover:shadow-md"
>
  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
    <RetailerIcon size={18} />
  </div>
  <div class="min-w-0">
    <p class="font-medium">{name}</p>
    <p class="mt-1 text-sm text-ink-soft">{description}</p>
    <p class="mt-2 text-sm font-medium text-accent">{retailerLabel[retailer]} →</p>
  </div>
</a>
