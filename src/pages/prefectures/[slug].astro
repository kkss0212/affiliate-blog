---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AffiliateDisclosure from "../../components/AffiliateDisclosure.astro";
import ProductCard from "../../components/ProductCard.astro";
import ExperienceCard from "../../components/ExperienceCard.astro";

export async function getStaticPaths() {
  const prefectures = await getCollection("prefectures", ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  return prefectures.map((prefecture) => ({
    params: { slug: prefecture.id },
    props: { prefecture },
  }));
}

const { prefecture } = Astro.props;
const { data } = prefecture;
const { Content } = await render(prefecture);

const allMunicipalities = await getCollection("municipalities", ({ data: municipalityData }) => {
  const draftOk = import.meta.env.PROD ? municipalityData.draft !== true : true;
  return draftOk && municipalityData.prefecture.id === prefecture.id;
});
const municipalities = allMunicipalities.sort((a, b) => a.data.name.localeCompare(b.data.name));

const populationFormatted = new Intl.NumberFormat("en-US").format(data.population);
const areaFormatted = new Intl.NumberFormat("en-US").format(data.areaKm2);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={`${data.name} (${data.nameJa}) — history, data & travel guide | Japan Unpacked`}
  description={`A history- and data-driven guide to ${data.name} Prefecture, Japan.`}
>
  <p class="text-sm font-medium uppercase tracking-[0.15em] text-accent">{data.region}</p>
  <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight">
    {data.name} <span class="text-ink-faint">{data.nameJa}</span>
  </h1>

  <dl class="mt-6 grid grid-cols-2 gap-4 rounded-xl border border-line bg-white p-4 text-sm sm:grid-cols-4">
    <div>
      <dt class="text-ink-faint">Capital</dt>
      <dd class="font-medium">{data.capital}</dd>
    </div>
    <div>
      <dt class="text-ink-faint">Population</dt>
      <dd class="font-medium">{populationFormatted} <span class="text-ink-faint">({data.populationSourceYear})</span></dd>
    </div>
    <div>
      <dt class="text-ink-faint">Area</dt>
      <dd class="font-medium">{areaFormatted} km²</dd>
    </div>
  </dl>

  <ul class="mt-4 list-inside list-disc text-sm text-ink-soft">
    {data.highlights.map((highlight) => <li>{highlight}</li>)}
  </ul>

  {municipalities.length > 0 && (
    <section class="mt-10">
      <h2 class="font-display text-lg font-semibold">Municipalities in {data.name}</h2>
      <ul class="mt-3 grid gap-3 sm:grid-cols-2">
        {municipalities.map((municipality) => (
          <li>
            <a
              href={`${base}prefectures/${prefecture.id}/${municipality.id}/`}
              class="block rounded-xl border border-line bg-white p-4 transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <span class="font-medium">{municipality.data.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {(data.products.length > 0 || data.experiences.length > 0) && (
    <div class="mt-6">
      <AffiliateDisclosure />
    </div>
  )}

  <article class="prose prose-stone mt-6 max-w-none">
    <Content />
  </article>

  {data.experiences.length > 0 && (
    <section class="mt-10">
      <h2 class="font-display text-lg font-semibold">Book an experience</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        {data.experiences.map((experience) => (
          <ExperienceCard {...experience} />
        ))}
      </div>
    </section>
  )}

  {data.products.length > 0 && (
    <section class="mt-10">
      <h2 class="font-display text-lg font-semibold">Bring a piece of {data.name} home</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        {data.products.map((product) => (
          <ProductCard {...product} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
