---
interface Props {
  name: string;
  description: string;
  amazonUrl: string;
}

const { name, description, amazonUrl } = Astro.props;
---

<a
  href={amazonUrl}
  rel="sponsored noopener"
  target="_blank"
  class="block rounded-lg border border-slate-200 p-4 transition hover:border-slate-400"
>
  <p class="font-medium">{name}</p>
  <p class="mt-1 text-sm text-slate-600">{description}</p>
  <p class="mt-2 text-sm text-amber-700">View on Amazon →</p>
</a>
