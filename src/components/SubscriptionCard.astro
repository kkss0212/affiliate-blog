---
interface Props {
  name: string;
  description: string;
  url: string;
  service: "amazon-music-unlimited" | "kindle-unlimited";
}

const { name, description, url, service } = Astro.props;

const serviceLabel: Record<Props["service"], string> = {
  "amazon-music-unlimited": "Try Amazon Music Unlimited",
  "kindle-unlimited": "Try Kindle Unlimited",
};
---

<a
  href={url}
  rel="sponsored noopener"
  target="_blank"
  data-affiliate-kind="subscription"
  data-affiliate-channel={service}
  data-affiliate-name={name}
  class="block rounded-xl border border-line bg-white p-4 transition hover:-translate-y-0.5 hover:shadow-md"
>
  <p class="font-medium">{name}</p>
  <p class="mt-1 text-sm text-ink-soft">{description}</p>
  <p class="mt-2 text-sm font-medium text-accent">{serviceLabel[service]} →</p>
</a>
