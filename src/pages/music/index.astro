---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allEntries = await getCollection("music", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const entries = allEntries.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Japanese Music Guides | Japan Unpacked"
  description="Guides to Japanese music, artists, and genres, with ways to listen."
>
  <p class="text-sm font-medium uppercase tracking-[0.15em] text-accent">Japan Unpacked</p>
  <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight">Music</h1>
  <p class="mt-4 max-w-xl text-ink-soft">
    Guides to Japanese music, artists, and genres for people who want to
    listen deeper.
  </p>

  <ul class="mt-8 grid gap-3 sm:grid-cols-2">
    {
      entries.map((entry) => (
        <li>
          <a
            href={`${import.meta.env.BASE_URL}music/${entry.id}/`}
            class="block rounded-xl border border-line bg-white p-4 transition hover:-translate-y-0.5 hover:shadow-md"
          >
            <span class="font-medium">{entry.data.title}</span>
          </a>
        </li>
      ))
    }
  </ul>
  {entries.length === 0 && <p class="mt-4 text-sm text-ink-faint">More guides are on the way.</p>}
</BaseLayout>
