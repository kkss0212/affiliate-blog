---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const allMunicipalities = await getCollection("municipalities", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const municipalities = await Promise.all(
  allMunicipalities
    .sort((a, b) => a.data.name.localeCompare(b.data.name))
    .map(async (municipality) => ({
      municipality,
      prefecture: await getEntry(municipality.data.prefecture),
    })),
);
---

<BaseLayout
  title="Municipalities | Japan Unpacked"
  description="History- and data-driven guides to Japan's cities, wards, towns, and villages."
>
  <p class="text-sm font-medium uppercase tracking-[0.15em] text-accent">Japan Unpacked</p>
  <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight">Municipalities</h1>
  <p class="mt-4 max-w-xl text-ink-soft">
    Cities, special wards, towns, and villages — a closer look than a
    prefecture profile can give.
  </p>

  <ul class="mt-8 grid gap-3 sm:grid-cols-2">
    {
      municipalities.map(({ municipality, prefecture }) => (
        <li>
          <a
            href={`${base}municipalities/${municipality.id}/`}
            class="flex items-center justify-between rounded-xl border border-line bg-white p-4 transition hover:-translate-y-0.5 hover:shadow-md"
          >
            <span class="font-medium">{municipality.data.name}</span>
            <span class="rounded-full bg-accent-soft px-2 py-0.5 text-xs text-accent">
              {prefecture.data.name}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  {
    municipalities.length === 0 && (
      <p class="mt-4 text-sm text-ink-faint">More guides are on the way.</p>
    )
  }
</BaseLayout>
