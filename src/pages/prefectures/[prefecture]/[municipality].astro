---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AffiliateDisclosure from "../../../components/AffiliateDisclosure.astro";
import ProductCard from "../../../components/ProductCard.astro";
import ExperienceCard from "../../../components/ExperienceCard.astro";
import JapanMap from "../../../components/JapanMap.astro";
import StatCard from "../../../components/StatCard.astro";
import ScoreMeter from "../../../components/ScoreMeter.astro";
import ShareBar from "../../../components/ShareBar.astro";
import {
  Users,
  Landmark,
  Ruler,
  LayoutGrid,
  TrendingUp,
  TrendingDown,
  Minus,
  MessageCircle,
  Globe,
  Camera,
  Ticket,
  ShoppingBag,
  Factory,
  BookOpen,
  BookText,
} from "@lucide/astro";
import { JAPAN_TOTAL_POPULATION, JAPAN_TOTAL_POPULATION_YEAR, JAPAN_TOTAL_AREA_KM2 } from "../../../consts";

export async function getStaticPaths() {
  const municipalities = await getCollection("municipalities", ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  return municipalities.map((municipality) => ({
    params: { prefecture: municipality.data.prefecture.id, municipality: municipality.id },
    props: { municipality },
  }));
}

const { municipality } = Astro.props;
const { data } = municipality;
const { Content } = await render(municipality);
const prefecture = await getEntry(data.prefecture);

const kindLabel: Record<typeof data.kind, string> = {
  city: "City",
  "special-ward": "Special Ward",
  town: "Town",
  village: "Village",
};

const numberFormat = new Intl.NumberFormat("en-US");
const populationFormatted = numberFormat.format(data.population);
const areaFormatted = numberFormat.format(data.areaKm2);
const densityFormatted = new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 }).format(
  data.population / data.areaKm2,
);
const base = import.meta.env.BASE_URL;

const trendMeta: Record<"increasing" | "decreasing" | "stable", { label: string; icon: typeof TrendingUp }> = {
  increasing: { label: "Increasing", icon: TrendingUp },
  decreasing: { label: "Decreasing", icon: TrendingDown },
  stable: { label: "Stable", icon: Minus },
};
const TrendIcon = data.populationTrend ? trendMeta[data.populationTrend].icon : null;

const localSpecialties = data.products.filter((p) => (p.category ?? "local-specialty") === "local-specialty");
const companyPicks = data.products.filter((p) => p.category === "company");
const mangaPicks = data.products.filter((p) => p.category === "manga");
const otherPicks = data.products.filter((p) => p.category === "other");
---

<BaseLayout
  title={`${data.name} (${data.nameJa}) — history, data & travel guide | Japan Unpacked`}
  description={data.tagline ?? `A history- and data-driven guide to ${data.name}, ${prefecture.data.name} Prefecture, Japan.`}
>
  <!-- Hero: full-bleed image/gradient banner -->
  <div class="relative left-1/2 -mt-10 w-screen -translate-x-1/2 sm:-mt-10">
    <div class="relative h-[280px] w-full overflow-hidden bg-gradient-to-br from-ink to-accent-hover sm:h-[380px]">
      {data.heroImage && (
        <img
          src={data.heroImage.url}
          alt={data.heroImage.alt}
          class="absolute inset-0 h-full w-full object-cover"
          loading="eager"
        />
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-black/10" />
      <div class="absolute inset-0 flex items-end">
        <div class="mx-auto w-full max-w-4xl px-4 pb-8">
          <p class="flex items-center gap-1.5 text-sm font-medium uppercase tracking-[0.15em] text-white/80">
            {kindLabel[data.kind]} ·{" "}
            <a href={`${base}prefectures/${prefecture.id}/`} class="underline decoration-white/40 hover:decoration-white">
              {prefecture.data.name} Prefecture
            </a>
          </p>
          <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            {data.name} <span class="text-white/60">{data.nameJa}</span>
          </h1>
          {data.tagline && <p class="mt-2 max-w-2xl text-white/90">{data.tagline}</p>}
        </div>
      </div>
      {data.heroImage?.credit && (
        <p class="absolute bottom-1 right-2 text-[10px] text-white/50">{data.heroImage.credit}</p>
      )}
    </div>
  </div>

  <!-- Floating "at a glance" panel, overlapping the hero -->
  <section class="relative z-10 -mt-10 rounded-2xl border border-line bg-white p-4 shadow-lg sm:-mt-14 sm:p-6">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      <StatCard label="Prefecture" value={prefecture.data.name}>
        <Landmark slot="icon" size={18} />
      </StatCard>
      <StatCard label="Population" value={populationFormatted} sublabel={`${data.populationSourceYear} census`}>
        <Users slot="icon" size={18} />
      </StatCard>
      {data.populationTrend && TrendIcon && (
        <StatCard label="Population trend" value={trendMeta[data.populationTrend].label}>
          <TrendIcon slot="icon" size={18} />
        </StatCard>
      )}
      <StatCard label="Area" value={`${areaFormatted} km²`}>
        <Ruler slot="icon" size={18} />
      </StatCard>
      <StatCard label="Population density" value={`${densityFormatted} / km²`}>
        <LayoutGrid slot="icon" size={18} />
      </StatCard>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <ShareBar label="Share of Japan's population" value={data.population} nationalTotal={JAPAN_TOTAL_POPULATION} />
      <ShareBar label="Share of Japan's land area" value={data.areaKm2} nationalTotal={JAPAN_TOTAL_AREA_KM2} />
    </div>
    <p class="mt-1 text-xs text-ink-faint">
      Compared against Japan's {JAPAN_TOTAL_POPULATION_YEAR} census population of{" "}
      {numberFormat.format(JAPAN_TOTAL_POPULATION)} and total land area of {numberFormat.format(JAPAN_TOTAL_AREA_KM2)} km².
    </p>

    {(data.natureScore || data.subcultureScore) && (
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {data.natureScore && <ScoreMeter label="Nature" value={data.natureScore} />}
        {data.subcultureScore && <ScoreMeter label="Subculture" value={data.subcultureScore} />}
      </div>
    )}

    <div class="mt-4 grid gap-4 sm:grid-cols-[auto_1fr] sm:items-start">
      <JapanMap highlight={prefecture.id} label={`${prefecture.data.name} (home of ${data.name})`} class="mx-auto sm:mx-0" />
      <div class="grid gap-3">
        {data.prefecturalCharacter && (
          <div class="rounded-xl bg-accent-soft/60 p-3">
            <p class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-accent">
              <MessageCircle size={14} /> Often described as
            </p>
            <p class="mt-1 text-sm text-ink-soft">{data.prefecturalCharacter}</p>
          </div>
        )}
        {data.comparedTo && (
          <div class="rounded-xl bg-accent-soft/60 p-3">
            <p class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-accent">
              <Globe size={14} /> If it were in Europe or the US
            </p>
            <p class="mt-1 text-sm">
              <span class="font-medium">{data.comparedTo.place}, {data.comparedTo.country}</span>
              <span class="block text-ink-soft">{data.comparedTo.reason}</span>
            </p>
          </div>
        )}
      </div>
    </div>

    <ul class="mt-4 space-y-1.5 text-sm text-ink-soft">
      {data.highlights.map((highlight) => (
        <li class="flex gap-2">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
          {highlight}
        </li>
      ))}
    </ul>
  </section>

  {(data.products.length > 0 || data.experiences.length > 0) && (
    <div class="mt-6">
      <AffiliateDisclosure />
    </div>
  )}

  <article class="prose prose-stone mt-10 max-w-none">
    <h2 class="flex items-center gap-2 font-display text-lg font-semibold">
      <BookText size={18} class="text-accent" /> History
    </h2>
    <Content />
  </article>

  {data.touristSpots.length > 0 && (
    <section class="mt-10">
      <h2 class="flex items-center gap-2 font-display text-lg font-semibold">
        <Camera size={18} class="text-accent" /> Where to go
      </h2>
      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        {data.touristSpots.map((spot) => (
          <div class="overflow-hidden rounded-xl border border-line bg-white">
            {spot.image ? (
              <img
                src={spot.image.url}
                alt={spot.image.alt}
                class="aspect-[4/3] w-full object-cover"
                loading="lazy"
              />
            ) : (
              <div class="flex aspect-[4/3] w-full items-center justify-center bg-gradient-to-br from-accent-soft to-line text-accent">
                <Camera size={28} />
              </div>
            )}
            <div class="p-4">
              <p class="font-medium">{spot.name}</p>
              <p class="mt-1 text-sm text-ink-soft">{spot.description}</p>
              {spot.image?.credit && (
                <p class="mt-2 text-xs text-ink-faint">{spot.image.credit}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  {data.experiences.length > 0 && (
    <section class="mt-10">
      <h2 class="flex items-center gap-2 font-display text-lg font-semibold">
        <Ticket size={18} class="text-accent" /> Book an experience
      </h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        {data.experiences.map((experience) => (
          <ExperienceCard {...experience} />
        ))}
      </div>
    </section>
  )}

  {localSpecialties.length > 0 && (
    <section class="mt-10">
      <h2 class="flex items-center gap-2 font-display text-lg font-semibold">
        <ShoppingBag size={18} class="text-accent" /> Local specialties
      </h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        {localSpecialties.map((product) => (
          <ProductCard {...product} />
        ))}
      </div>
    </section>
  )}

  {(companyPicks.length > 0 || mangaPicks.length > 0) && (
    <section class="mt-10">
      <h2 class="flex items-center gap-2 font-display text-lg font-semibold">
        <Factory size={18} class="text-accent" /> Made or set in {data.name}
      </h2>
      {companyPicks.length > 0 && (
        <div class="mt-3">
          <h3 class="flex items-center gap-1.5 text-sm font-medium text-ink-soft">
            <Factory size={14} /> Companies from {data.name}
          </h3>
          <div class="mt-2 grid gap-3 sm:grid-cols-2">
            {companyPicks.map((product) => (
              <ProductCard {...product} />
            ))}
          </div>
        </div>
      )}
      {mangaPicks.length > 0 && (
        <div class="mt-5">
          <h3 class="flex items-center gap-1.5 text-sm font-medium text-ink-soft">
            <BookOpen size={14} /> Manga set here
          </h3>
          <div class="mt-2 grid gap-3 sm:grid-cols-2">
            {mangaPicks.map((product) => (
              <ProductCard {...product} />
            ))}
          </div>
        </div>
      )}
    </section>
  )}

  {otherPicks.length > 0 && (
    <section class="mt-10">
      <h2 class="font-display text-lg font-semibold">More from {data.name}</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        {otherPicks.map((product) => (
          <ProductCard {...product} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
