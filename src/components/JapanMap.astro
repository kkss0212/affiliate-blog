---
// "You are here" map using @svg-maps/japan — a real, accurate SVG of all
// 47 prefecture shapes (CC BY 4.0, https://github.com/VictorCazanave/svg-maps),
// whose location ids already match this project's prefecture slugs
// exactly (e.g. "kyoto", "hokkaido"). Highlights one prefecture's actual
// shape rather than an approximate dot — replaces the earlier hand-drawn
// schematic silhouette.
import japan from "@svg-maps/japan";

interface Props {
  highlight?: string;
  label: string;
  class?: string;
  interactive?: boolean;
}

const { highlight, label, class: className, interactive } = Astro.props;
---

<figure class={`inline-block ${className ?? ""}`}>
  <svg
    viewBox={japan.viewBox}
    class="jp-map h-56 w-auto sm:h-64"
    role="img"
    aria-label={interactive ? "Interactive map of Japan's 47 prefectures" : `Map of Japan with ${label} highlighted`}
  >
    {
      japan.locations.map((loc: { id: string; path: string; name: string }) => (
        <path
          d={loc.path}
          data-prefecture={loc.id}
          class={`jp-pref ${highlight === loc.id ? "jp-pref-active" : ""}`}
        >
          <title>{loc.name}</title>
        </path>
      ))
    }
  </svg>
  <figcaption class="mt-1 text-xs text-ink-faint">
    {interactive ? "Hover or tap a prefecture to see where it is" : `${label} highlighted`}
    <span class="block text-[10px] text-ink-faint/70">Map data © contributors, CC BY 4.0</span>
  </figcaption>
</figure>

<style>
  .jp-pref {
    fill: #dcd7cd;
    stroke: #faf8f6;
    stroke-width: 0.6;
    transition: fill 0.15s ease;
  }
  .jp-pref-active {
    fill: #a3412c;
  }
  .jp-map:hover .jp-pref:hover {
    fill: #832f1f;
  }
</style>
