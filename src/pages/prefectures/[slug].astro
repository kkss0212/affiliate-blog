---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AffiliateDisclosure from "../../components/AffiliateDisclosure.astro";
import ProductCard from "../../components/ProductCard.astro";
import ExperienceCard from "../../components/ExperienceCard.astro";

export async function getStaticPaths() {
  const prefectures = await getCollection("prefectures", ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  return prefectures.map((prefecture) => ({
    params: { slug: prefecture.id },
    props: { prefecture },
  }));
}

const { prefecture } = Astro.props;
const { data } = prefecture;
const { Content } = await render(prefecture);

const populationFormatted = new Intl.NumberFormat("en-US").format(data.population);
const areaFormatted = new Intl.NumberFormat("en-US").format(data.areaKm2);
---

<BaseLayout
  title={`${data.name} (${data.nameJa}) — history, data & travel guide | Japan Unpacked`}
  description={`A history- and data-driven guide to ${data.name} Prefecture, Japan.`}
>
  <p class="text-sm text-slate-500">{data.region}</p>
  <h1 class="text-2xl font-semibold">
    {data.name} <span class="text-slate-400">{data.nameJa}</span>
  </h1>

  <dl class="mt-4 grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">
    <div>
      <dt class="text-slate-500">Capital</dt>
      <dd class="font-medium">{data.capital}</dd>
    </div>
    <div>
      <dt class="text-slate-500">Population</dt>
      <dd class="font-medium">{populationFormatted} <span class="text-slate-400">({data.populationSourceYear})</span></dd>
    </div>
    <div>
      <dt class="text-slate-500">Area</dt>
      <dd class="font-medium">{areaFormatted} km²</dd>
    </div>
  </dl>

  <ul class="mt-4 list-inside list-disc text-sm text-slate-700">
    {data.highlights.map((highlight) => <li>{highlight}</li>)}
  </ul>

  {(data.products.length > 0 || data.experiences.length > 0) && (
    <div class="mt-6">
      <AffiliateDisclosure />
    </div>
  )}

  <article class="prose prose-slate mt-6 max-w-none">
    <Content />
  </article>

  {data.experiences.length > 0 && (
    <section class="mt-8">
      <h2 class="text-lg font-semibold">Book an experience</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        {data.experiences.map((experience) => (
          <ExperienceCard {...experience} />
        ))}
      </div>
    </section>
  )}

  {data.products.length > 0 && (
    <section class="mt-8">
      <h2 class="text-lg font-semibold">Bring a piece of {data.name} home</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        {data.products.map((product) => (
          <ProductCard {...product} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
